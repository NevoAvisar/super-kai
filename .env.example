# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/super_kai?schema=public"

# "mock" = serve the catalog from src/data/catalog-seed.ts (no DB needed)
# "db"   = read the catalog from PostgreSQL via Prisma
CATALOG_SOURCE="mock"

# --- AI product photos (npm run generate-images) ---
# Create a key at https://platform.openai.com/api-keys. Never commit the real .env.
OPENAI_API_KEY=""
# Optional overrides
# OPENAI_IMAGE_MODEL="gpt-image-2.5-sunburst"
# OPENAI_IMAGE_QUALITY="high"        # low | medium | high | xhigh | max | auto
# OPENAI_IMAGE_SIZE="1536x1024"
# OPENAI_IMAGE_CONCURRENCY="3"

# --- Unsplash product photos (npm run fetch-photos) ---
# Free Access Key: https://unsplash.com/oauth/applications → New Application
UNSPLASH_ACCESS_KEY=""

# --- Login (Supabase Auth: Google, Apple, email + password) ---
# Project Settings → API in the Supabase dashboard. Both values are public by design.
# Add <site-url>/login to Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Link previews (WhatsApp / Facebook / X / LinkedIn) ---
# The public site address. Open Graph images must be absolute URLs; this is the base they use.
# Defaults to https://super-kai.vercel.app when unset.
NEXT_PUBLIC_SITE_URL="https://super-kai.vercel.app"
